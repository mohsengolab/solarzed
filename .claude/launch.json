{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "solarzed",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "serve.cjs"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5010"
      ],
      "port": 5010,
      "env": {
        "FrontendOrigin": "http://localhost:3000",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000,
      "env": {
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only"
      }
    },
    {
      "name": "api-5296",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5296"
      ],
      "port": 5296,
      "env": {
        "FrontendOrigin": "http://localhost:3000",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "Sms__DevConsole": "true"
      }
    },
    {
      "name": "api-qa",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5296"
      ],
      "port": 5296,
      "env": {
        "ConnectionStrings__Default": "Server=(localdb)\\mssqllocaldb;Database=SolarzedManualQA;Trusted_Connection=True;",
        "FrontendOrigin": "http://localhost:3000",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "Sms__DevConsole": "true",
        "Email__DevConsole": "true"
      }
    },
    {
      "name": "api-partners",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "-c",
        "Release",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5311"
      ],
      "port": 5311,
      "env": {
        "ConnectionStrings__Default": "Server=(localdb)\\mssqllocaldb;Database=SolarzedPartnersQA;Trusted_Connection=True;",
        "FrontendOrigin": "http://localhost:3011",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "Sms__DevConsole": "true",
        "Email__DevConsole": "true"
      }
    },
    {
      "name": "web-partners",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "start",
        "--",
        "--port",
        "3011"
      ],
      "port": 3011,
      "env": {
        "BACKEND_URL": "http://localhost:5311",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only"
      }
    },
    {
      "name": "api-sn",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "-c",
        "Ef",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5320"
      ],
      "port": 5320,
      "env": {
        "ConnectionStrings__Default": "Server=(localdb)\\mssqllocaldb;Database=SolarzedSerialQA;Trusted_Connection=True;",
        "FrontendOrigin": "http://localhost:3020",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "Sms__DevConsole": "true",
        "Email__DevConsole": "true"
      }
    },
    {
      "name": "web-sn",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3020"
      ],
      "port": 3020,
      "env": {
        "BACKEND_URL": "http://localhost:5320",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "NEXT_DIST_DIR": ".next-sn"
      }
    },
    {
      "name": "api-history",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Solarzed.Api",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5330"
      ],
      "port": 5330,
      "env": {
        "ConnectionStrings__Default": "Server=(localdb)\\mssqllocaldb;Database=SolarzedRollHistoryQA;Trusted_Connection=True;",
        "FrontendOrigin": "http://localhost:3030",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "Sms__DevConsole": "true",
        "Email__DevConsole": "true"
      }
    },
    {
      "name": "web-history",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3030"
      ],
      "port": 3030,
      "env": {
        "BACKEND_URL": "http://localhost:5330",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only",
        "NEXT_DIST_DIR": ".next-history"
      }
    }
  ]
}