{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "solarzed",
      "runtimeExecutable": "node",
      "runtimeArgs": ["serve.cjs"],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/Solarzed.Api", "--launch-profile", "http", "--urls", "http://localhost:5010"],
      "port": 5010,
      "env": {
        "FrontendOrigin": "http://localhost:3000",
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "3000"],
      "port": 3000,
      "env": {
        "SOLARZED_REVALIDATE_SECRET": "local-dev-revalidate-secret-only"
      }
    }
  ]
}
