{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-a/types/**/*.ts",
    ".next-a/dev/types/**/*.ts",
    ".next-b/types/**/*.ts",
    ".next-b/dev/types/**/*.ts",
    ".next-history/types/**/*.ts",
    ".next-history/dev/types/**/*.ts",
    ".next-roles/types/**/*.ts",
    ".next-roles/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-glass/types/**/*.ts",
    ".next-glass/dev/types/**/*.ts",
    ".next-lang/types/**/*.ts",
    ".next-lang/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e",
    "test-results",
    "playwright-report"
  ]
}
